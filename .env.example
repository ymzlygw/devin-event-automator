# Devin API credentials
DEVIN_API_KEY=your-devin-service-user-api-key
DEVIN_ORG_ID=org-xxxxxxxxxxxxxxxx

# Shared secret configured on the GitHub webhook (used to validate signatures)
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# ngrok auth token (https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_TOKEN=your-ngrok-authtoken
# Optional: reserved/custom ngrok domain (leave blank for a random URL)
NGROK_DOMAIN=
